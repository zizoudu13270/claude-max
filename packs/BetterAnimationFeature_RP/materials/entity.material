{
  "materials": {
    "version": "1.0.0",
    "lbr_baf_player_base:entity_alphablend": {
      "-defines": [
        "FANCY"
      ],
      "-states": [
        "DisableCulling"
      ]
    },
    "lbr_baf_player_uv_anim:lbr_baf_player_base": {
      "+defines": [
        "USE_UV_ANIM"
      ],
      "+samplerStates": [
        {
          "samplerIndex": 0,
          "textureFilter": "Bilinear",
          "textureWrap": "Repeat"
        }
      ]
    },
    "lbr_baf_player_overlay:lbr_baf_player_uv_anim": {
      "+states": [
        "DisableCulling"
      ],
      "depthFunc": "LessEqual"
    },
    "lbr_baf_player_overlay_equal:lbr_baf_player_overlay": {
      "depthFunc": "Equal"
    }
  }
}
