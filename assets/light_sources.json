    { "name": "ochre_froglight", "vanilla_item": "minecraft:ochre_froglight", "vanilla_block": "minecraft:ochre_froglight", "texture": "textures/blocks/ochre_froglight_side" },
    { "name": "verdant_froglight", "vanilla_item": "minecraft:verdant_froglight", "vanilla_block": "minecraft:verdant_froglight", "texture": "textures/blocks/verdant_froglight_side" },
    { "name": "pearlescent_froglight", "vanilla_item": "minecraft:pearlescent_froglight", "vanilla_block": "minecraft:pearlescent_froglight", "texture": "textures/blocks/pearlescent_froglight_side" },
